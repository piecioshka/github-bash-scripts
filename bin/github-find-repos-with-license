#!/usr/bin/env bash
# Usage:
#   github-find-repos-with-license -u <username>                   # all repos with a LICENSE file (forks excluded)
#   github-find-repos-with-license -u <username> -n                # only Node.js projects (have package.json)
#   github-find-repos-with-license -u <username> -v public         # only public
#   github-find-repos-with-license -u <username> -v private        # only private
#   github-find-repos-with-license -u <username> -F                # include forks
#   github-find-repos-with-license -u <username> -o                # also save URLs to auto-named file in $PWD
#   github-find-repos-with-license -u <username> -o out.txt        # also save URLs to a specific file
#   github-find-repos-with-license --help                          # show help
#
# Lists repositories whose HEAD root tree contains a LICENSE-like file
# (LICENSE, LICENCE, COPYING, UNLICENSE - optionally with an extension or a
# -SUFFIX, e.g. LICENSE.md, LICENSE.txt or LICENSE-MIT / LICENSE-APACHE).
# With -n / --node-only, also requires a root package.json (Node.js projects).
# Handy for spotting repos that carry a license file you may want to drop.
# By default prints repo slugs to stdout. Pass -o to also save repo URLs -
# bare -o generates <PWD>/licenses-<username>_<timestamp>.txt, -o <path> uses
# that path.
#
# Requires: gh CLI (authenticated)

set -u

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../shared/__shared.sh
source "$script_dir/../shared/__shared.sh"

NODE_ONLY=0
CONCURRENCY="${CONCURRENCY:-10}"

if [[ $# -eq 0 && -t 0 ]]; then
    show_usage
    exit 0
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -u|--user)
            [[ -z "${2:-}" ]] && { echo "ERROR: --user requires a username" >&2; exit 1; }
            GH_USER="$2"; shift 2 ;;
        -v|--visibility)
            [[ -z "${2:-}" ]] && { echo "ERROR: --visibility requires a value" >&2; exit 1; }
            VISIBILITY="$2"; shift 2 ;;
        -F|--include-forks)
            INCLUDE_FORKS=1; shift ;;
        -n|--node-only)
            NODE_ONLY=1; shift ;;
        -o|--output)
            if [[ -z "${2:-}" || "${2:-}" == -* ]]; then
                OUTPUT_FILE="__AUTO__"; shift 1
            else
                OUTPUT_FILE="$2"; shift 2
            fi ;;
        -h|--help)
            show_usage; exit 0 ;;
        *)
            echo "Unknown argument: $1 (use --help)" >&2; exit 1 ;;
    esac
done

if [[ -z "$GH_USER" ]]; then
    echo "ERROR: -u <username> is required" >&2
    show_usage
    exit 1
fi

require_cmd gh "brew install gh"
validate_visibility "$VISIBILITY"

if [[ "$OUTPUT_FILE" == "__AUTO__" ]]; then
    TIMESTAMP="$(make_timestamp)"
    OUTPUT_FILE="$PWD/licenses-${GH_USER}_${TIMESTAMP}.txt"
fi

vis_args=()
[[ "$VISIBILITY" != "all" ]] && vis_args=(--visibility "$VISIBILITY")

jq_filter='.[]'
[[ "$INCLUDE_FORKS" == "0" ]] && jq_filter='.[] | select(.isFork==false)'
jq_filter="$jq_filter | [.nameWithOwner, (.visibility | ascii_downcase), (.isFork|tostring), (.isArchived|tostring), (.licenseInfo.key // \"-\")] | @tsv"

print_kv "User" "$GH_USER"
print_kv "Visibility" "$VISIBILITY"
print_kv "Forks" "$([[ $INCLUDE_FORKS == 1 ]] && echo included || echo excluded)"
print_kv "Node-only" "$([[ $NODE_ONLY == 1 ]] && echo yes || echo no)"
print_kv "Concurrency" "$CONCURRENCY"
[[ -n "$OUTPUT_FILE" ]] && print_kv "Output" "$OUTPUT_FILE"
echo

repos=$(gh repo list "$GH_USER" "${vis_args[@]}" --limit 1000 \
    --json nameWithOwner,visibility,isFork,isArchived,licenseInfo --jq "$jq_filter")

if [[ -z "$repos" ]]; then
    echo "No repos match the filter."
    [[ -n "$OUTPUT_FILE" ]] && : > "$OUTPUT_FILE"
    exit 0
fi

total=$(echo "$repos" | wc -l | tr -d ' ')
echo "Checking $total repos for a LICENSE file$([[ $NODE_ONLY == 1 ]] && echo ' (Node.js only)')..."
echo

check_license() {
    local slug="$1" vis="$2" is_fork="$3" is_archived="$4" lic_key="$5"
    local tree license_file
    tree=$(gh api "repos/$slug/git/trees/HEAD" \
        --jq '.tree[] | select(.type=="blob") | .path' 2>/dev/null)
    [[ -z "$tree" ]] && return
    license_file=$(printf '%s\n' "$tree" \
        | grep -iE '^(LICEN[CS]E|COPYING|UNLICENSE)([-.].*)?$' | head -n1)
    [[ -z "$license_file" ]] && return
    if [[ "$NODE_ONLY" == "1" ]]; then
        printf '%s\n' "$tree" | grep -ixqF 'package.json' || return
    fi
    printf "%s\t%s\t%s\t%s\t%s\t%s\n" "$slug" "$vis" "$is_fork" "$is_archived" "$lic_key" "$license_file"
}
export -f check_license
export NODE_ONLY

# Note: TSV fields are passed as separate positional args - BSD xargs collapses
# tabs inside -I {} substitution, so we split on whitespace via -n 5 instead.
results=$(echo "$repos" | tr '\t' ' ' \
    | xargs -n 5 -P "$CONCURRENCY" bash -c 'check_license "$@"' _)

if [[ -n "$results" ]]; then
    while IFS=$'\t' read -r slug vis is_fork is_archived lic_key license_file; do
        [[ -z "$slug" ]] && continue
        lic_badge=""
        [[ "$lic_key" != "-" && -n "$lic_key" ]] && lic_badge=" ${C_CYAN}[$lic_key]${C_RESET}"
        badges="$(format_badges "$vis" "$is_fork" "$is_archived")"
        printf "${C_GREEN}✓${C_RESET} %-60s ${C_DIM}→${C_RESET} %s%s%s\n" "$slug" "$license_file" "$lic_badge" "$badges"
    done <<< "$(echo "$results" | sort)"
fi

urls=$(echo "$results" | cut -f1 | grep -v '^$' | sort -u \
    | awk '{print "https://github.com/" $0}')

found=$(echo "$urls" | grep -c . || true)
echo
echo "${C_BOLD}${C_DIM}Found $found/$total repos with a LICENSE file$([[ $NODE_ONLY == 1 ]] && echo ' (Node.js only)').${C_RESET}"

if [[ -n "$OUTPUT_FILE" ]]; then
    echo "$urls" > "$OUTPUT_FILE"
    echo "Written to: $OUTPUT_FILE"
fi
