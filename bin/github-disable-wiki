#!/usr/bin/env bash
# Usage:
#   github-disable-wiki -u <username>                    # all non-fork repos of a user
#   github-disable-wiki -u <username> -v public          # only public
#   github-disable-wiki -u <username> -v private         # only private
#   github-disable-wiki -u <username> -F                 # include forks
#   github-disable-wiki -f links.txt                     # repos from a file
#   echo "https://github.com/o/r" | github-disable-wiki  # repos from stdin
#   github-disable-wiki owner/repo another/repo          # positional slugs
#   github-disable-wiki -u <username> --force            # disable wiki even if it has pages
#   DRY_RUN=1 github-disable-wiki -u <username>          # show what would be done
#   github-disable-wiki --dry-run -u <username>         # same as DRY_RUN=1
#   github-disable-wiki --help                           # show help
#
# For each repo on the list: if the wiki feature is enabled but the wiki has no
# pages (empty wiki), disables the wiki feature. Repos whose wiki is already off,
# or whose wiki HAS pages, are skipped - unless --force, which disables the wiki
# feature regardless of content (the pages are NOT deleted; re-enabling the wiki
# brings them back).
#
# Pairs with github-find-repos-with-wiki: `github-find-repos-with-wiki -u me -e -o w.txt`
# then `github-disable-wiki -f w.txt`.
#
# Accepts repo URLs (one per line, lines starting with # are ignored):
#   - https://github.com/owner/repo
#
# Exit codes: 0 = no failures, 1 = at least one repo ended in a FAIL row.
#
# Requires: gh CLI (authenticated) with admin access on the repos, git.

set -u

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../shared/__shared.sh
source "$script_dir/../shared/__shared.sh"

normalize_dry_run

if [[ $# -eq 0 && -t 0 ]]; then
    show_usage
    exit 0
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -u|--user)
            [[ -z "${2:-}" ]] && { echo "ERROR: --user requires a username" >&2; exit 1; }
            GH_USER="$2"; shift 2 ;;
        -v|--visibility)
            [[ -z "${2:-}" ]] && { echo "ERROR: --visibility requires a value" >&2; exit 1; }
            VISIBILITY="$2"; shift 2 ;;
        -F|--include-forks)
            INCLUDE_FORKS=1; shift ;;
        -f|--file)
            [[ -z "${2:-}" ]] && { echo "ERROR: --file requires a path" >&2; exit 1; }
            INPUT_FILE="$2"; shift 2 ;;
        --force)
            FORCE=1; shift ;;
        --dry-run)
            DRY_RUN=1; shift ;;
        -h|--help)
            show_usage; exit 0 ;;
        -*)
            echo "Unknown flag: $1 (use -f <file>, -u <username>, --force, --dry-run or --help)" >&2; exit 1 ;;
        *)
            POSITIONAL+=("$1"); shift ;;
    esac
done

require_cmd gh "brew install gh"
require_cmd git
validate_visibility "$VISIBILITY"

# Token for the wiki content check - passed to git via the git_authed
# credential helper that reads an env var, never on the command line.
require_gh_token

# Echoes the wiki state: "pages" (has >=1 page), "empty" (no wiki repo -
# GitHub reports "Repository not found"), or "error" (inconclusive: network,
# auth or rate limit). Auth comes from the GH_HELPER_TOKEN credential helper.
wiki_state() {
    local slug="$1" out rc
    out=$(git_authed ls-remote "https://github.com/$slug.wiki.git" 2>&1)
    rc=$?
    if [[ $rc -eq 0 ]]; then
        [[ -n "$out" ]] && echo "pages" || echo "empty"
    elif grep -qi 'not found' <<< "$out"; then
        echo "empty"
    else
        echo "error"
    fi
}

disable_wiki() {
    local url="$1"
    local slug
    slug=$(url_to_slug "$url")

    if [[ -z "$slug" ]]; then
        print_row "SKIP" "$url" "unrecognized URL"
        return
    fi

    local enabled
    if ! enabled=$(gh api "repos/$slug" --jq '.has_wiki' 2>/dev/null); then
        FAILED=$((FAILED + 1)); print_row "FAIL" "$slug" "cannot read repo (404 or no access)"
        return
    fi

    if [[ "$enabled" != "true" ]]; then
        print_row "KEEP" "$slug" "wiki feature already disabled"
        return
    fi

    # Wiki feature is on - decide based on its content (unless forced).
    if [[ "$FORCE" != "1" ]]; then
        local state
        state=$(wiki_state "$slug")
        case "$state" in
            pages)
                print_row "KEEP" "$slug" "wiki has pages - not empty (use --force to disable anyway)"
                return ;;
            error)
                FAILED=$((FAILED + 1)); print_row "FAIL" "$slug" "wiki check inconclusive (network/auth?) - skipped for safety"
                return ;;
        esac
    fi

    if [[ "$DRY_RUN" == "1" ]]; then
        local note="would disable wiki feature"
        [[ "$FORCE" == "1" ]] && note="$note [forced - may have pages]"
        print_row "DRY" "$slug" "$note"
        return
    fi

    local out
    if out=$(gh repo edit "$slug" --enable-wiki=false 2>&1); then
        print_row "OK" "$slug" "wiki feature disabled"
    else
        FAILED=$((FAILED + 1)); print_row "FAIL" "$slug" "$(echo "$out" | head -n 1)"
    fi
}

[[ "$DRY_RUN" == "1" ]] && echo "${C_YELLOW}== DRY RUN - nothing will be changed ==${C_RESET}"
[[ "$FORCE" == "1" ]] && echo "${C_RED}== FORCE mode - will disable wiki even if it has pages ==${C_RESET}"

validate_input_source

FAILED=0
while read -r url; do
    disable_wiki "$url"
done < <(input_source "hasWikiEnabled" ".hasWikiEnabled==true" "(wiki enabled)" \
    | grep -vE '^[[:space:]]*(#|$)' \
    | grep -Eo 'https?://[^ ]+')

# Exit 1 when any repo ended in a FAIL row (useful for chaining and CI).
[[ "$FAILED" -gt 0 ]] && exit 1
exit 0
