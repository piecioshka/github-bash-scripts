#!/usr/bin/env bash
# Usage:
#   github-disable-projects-feature -u <username>                    # all non-fork repos of a user
#   github-disable-projects-feature -u <username> -v public          # only public
#   github-disable-projects-feature -u <username> -v private         # only private
#   github-disable-projects-feature -u <username> -F                 # include forks
#   github-disable-projects-feature -f links.txt                     # repos from a file
#   echo "https://github.com/o/r" | github-disable-projects-feature  # repos from stdin
#   github-disable-projects-feature owner/repo another/repo          # positional slugs
#   github-disable-projects-feature -u <username> --force            # disable even if projects exist
#   DRY_RUN=1 github-disable-projects-feature -u <username>          # show what would be done
#   github-disable-projects-feature --dry-run -u <username>         # same as DRY_RUN=1
#   github-disable-projects-feature --help                           # show help
#
# For each repo on the list: if the Projects feature is enabled but no Projects
# are linked to the repo (empty), disables the Projects feature. Repos whose
# Projects feature is already off, or that have linked Projects, are skipped -
# unless --force, which disables the feature regardless (the project boards
# themselves are not deleted; they just stop showing on the repo's Projects tab).
# Linked-project count comes from GraphQL `projectsV2`; classic boards are not
# counted.
#
# Pairs with github-find-repos-with-projects-feature: `github-find-repos-with-projects-feature -u me -e -o p.txt`
# then `github-disable-projects-feature -f p.txt`.
#
# Accepts repo URLs (one per line, lines starting with # are ignored):
#   - https://github.com/owner/repo
#
# Exit codes: 0 = no failures, 1 = at least one repo ended in a FAIL row.
#
# Requires: gh CLI (authenticated, with read:project scope) and admin access.

set -u

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../shared/__shared.sh
source "$script_dir/../shared/__shared.sh"

normalize_dry_run

if [[ $# -eq 0 && -t 0 ]]; then
    show_usage
    exit 0
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -u|--user)
            [[ -z "${2:-}" ]] && { echo "ERROR: --user requires a username" >&2; exit 1; }
            GH_USER="$2"; shift 2 ;;
        -v|--visibility)
            [[ -z "${2:-}" ]] && { echo "ERROR: --visibility requires a value" >&2; exit 1; }
            VISIBILITY="$2"; shift 2 ;;
        -F|--include-forks)
            INCLUDE_FORKS=1; shift ;;
        -f|--file)
            [[ -z "${2:-}" ]] && { echo "ERROR: --file requires a path" >&2; exit 1; }
            INPUT_FILE="$2"; shift 2 ;;
        --force)
            FORCE=1; shift ;;
        --dry-run)
            DRY_RUN=1; shift ;;
        -h|--help)
            show_usage; exit 0 ;;
        -*)
            echo "Unknown flag: $1 (use -f <file>, -u <username>, --force, --dry-run or --help)" >&2; exit 1 ;;
        *)
            POSITIONAL+=("$1"); shift ;;
    esac
done

require_cmd gh "brew install gh"
validate_visibility "$VISIBILITY"

# Echoes the number of Projects v2 linked to the repo (or "" on error).
projects_count() {
    local slug="$1"
    local owner="${slug%%/*}" name="${slug#*/}"
    # shellcheck disable=SC2016  # $owner/$name are GraphQL variables - must stay literal, gh binds them via -f
    gh api graphql \
        -f query='query($owner:String!,$name:String!){repository(owner:$owner,name:$name){projectsV2(first:1){totalCount}}}' \
        -f owner="$owner" -f name="$name" \
        --jq '.data.repository.projectsV2.totalCount' 2>/dev/null
}

disable_projects() {
    local url="$1"
    local slug
    slug=$(url_to_slug "$url")

    if [[ -z "$slug" ]]; then
        print_row "SKIP" "$url" "unrecognized URL"
        return
    fi

    local enabled
    if ! enabled=$(gh api "repos/$slug" --jq '.has_projects' 2>/dev/null); then
        FAILED=$((FAILED + 1)); print_row "FAIL" "$slug" "cannot read repo (404 or no access)"
        return
    fi

    if [[ "$enabled" != "true" ]]; then
        print_row "KEEP" "$slug" "Projects feature already disabled"
        return
    fi

    if [[ "$FORCE" != "1" ]]; then
        local count
        count=$(projects_count "$slug")
        if [[ -z "$count" ]]; then
            FAILED=$((FAILED + 1)); print_row "FAIL" "$slug" "projects check inconclusive (read:project scope?) - skipped for safety"
            return
        fi
        if [[ "$count" != "0" ]]; then
            print_row "KEEP" "$slug" "has $count linked project(s) - not empty (use --force)"
            return
        fi
    fi

    if [[ "$DRY_RUN" == "1" ]]; then
        local note="would disable Projects feature"
        [[ "$FORCE" == "1" ]] && note="$note [forced - may have projects]"
        print_row "DRY" "$slug" "$note"
        return
    fi

    local out
    if out=$(gh repo edit "$slug" --enable-projects=false 2>&1); then
        print_row "OK" "$slug" "Projects feature disabled"
    else
        FAILED=$((FAILED + 1)); print_row "FAIL" "$slug" "$(echo "$out" | head -n 1)"
    fi
}

[[ "$DRY_RUN" == "1" ]] && echo "${C_YELLOW}== DRY RUN - nothing will be changed ==${C_RESET}"
[[ "$FORCE" == "1" ]] && echo "${C_RED}== FORCE mode - will disable Projects even if projects exist ==${C_RESET}"

validate_input_source

FAILED=0
while read -r url; do
    disable_projects "$url"
done < <(input_source "hasProjectsEnabled" ".hasProjectsEnabled==true" "(projects enabled)" \
    | grep -vE '^[[:space:]]*(#|$)' \
    | grep -Eo 'https?://[^ ]+')

# Exit 1 when any repo ended in a FAIL row (useful for chaining and CI).
[[ "$FAILED" -gt 0 ]] && exit 1
exit 0
