#!/usr/bin/env bash
# Usage:
#   github-find-repos-with-homepage -u <username>              # all repos (forks excluded)
#   github-find-repos-with-homepage -u <username> -v public    # only public
#   github-find-repos-with-homepage -u <username> -v private   # only private
#   github-find-repos-with-homepage -u <username> -F           # include forks
#   github-find-repos-with-homepage -u <username> -e           # only broken homepages (non-2xx/3xx)
#   github-find-repos-with-homepage -u <username> -n           # just list, skip the HTTP check
#   github-find-repos-with-homepage -u <username> -r           # output repo URLs (github.com/owner/repo)
#   github-find-repos-with-homepage -u <username> -o           # also save URLs to auto-named file in $PWD
#   github-find-repos-with-homepage -u <username> -o out.txt   # also save URLs to a specific file
#   github-find-repos-with-homepage --help                     # show help
#
# Lists repositories with a homepage set and checks each URL over HTTP:
# OK for 2xx/3xx, BROKEN otherwise. Pass -e / --only-broken to keep only the
# BROKEN rows (with -r that output chains into github-clear-homepage).
# Pass -n / --no-check for an instant list straight from repo metadata,
# without touching the homepages over HTTP (-e makes no sense then).
# Default mode: homepage URLs. With -r / --repo-url: repository URLs.
# By default prints to stdout only. Pass -o to also save a file - bare -o
# generates <PWD>/homepage-checked[-repos]-<username>_<timestamp>.txt
# (homepage-broken[-repos]-<username>_… with --only-broken and
# homepage[-repos]-<username>_… with --no-check), -o <path> uses that path.
#
# Env:
#   CONCURRENCY=10   parallelism for URL checks
#   TIMEOUT=15       per-request timeout in seconds
#
# Exit codes: 0 = all checked homepages OK (or -n), 1 = at least one BROKEN.
#
# Requires: gh CLI (authenticated), curl

set -u

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../shared/__shared.sh
source "$script_dir/../shared/__shared.sh"

BROKEN_ONLY=0
NO_CHECK=0
OUTPUT_MODE="homepage"    # homepage | repo
CONCURRENCY="${CONCURRENCY:-10}"
TIMEOUT="${TIMEOUT:-15}"

if [[ $# -eq 0 && -t 0 ]]; then
    show_usage
    exit 0
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -u|--user)
            [[ -z "${2:-}" ]] && { echo "ERROR: --user requires a username" >&2; exit 1; }
            GH_USER="$2"; shift 2 ;;
        -v|--visibility)
            [[ -z "${2:-}" ]] && { echo "ERROR: --visibility requires a value" >&2; exit 1; }
            VISIBILITY="$2"; shift 2 ;;
        -F|--include-forks)
            INCLUDE_FORKS=1; shift ;;
        -r|--repo-url)
            OUTPUT_MODE="repo"; shift ;;
        -e|--only-broken)
            BROKEN_ONLY=1; shift ;;
        -n|--no-check)
            NO_CHECK=1; shift ;;
        -o|--output)
            if [[ -z "${2:-}" || "${2:-}" == -* ]]; then
                OUTPUT_FILE="__AUTO__"; shift 1
            else
                OUTPUT_FILE="$2"; shift 2
            fi ;;
        -h|--help)
            show_usage; exit 0 ;;
        *)
            echo "Unknown argument: $1 (use --help)" >&2; exit 1 ;;
    esac
done

if [[ -z "$GH_USER" ]]; then
    echo "ERROR: -u <username> is required" >&2
    show_usage
    exit 1
fi

require_cmd gh "brew install gh"
require_cmd curl
validate_visibility "$VISIBILITY"

if [[ "$NO_CHECK" == "1" && "$BROKEN_ONLY" == "1" ]]; then
    echo "ERROR: -n/--no-check cannot be combined with -e/--only-broken" >&2
    exit 1
fi

if [[ "$OUTPUT_FILE" == "__AUTO__" ]]; then
    TIMESTAMP="$(make_timestamp)"
    PREFIX="homepage-checked"
    [[ "$BROKEN_ONLY" == "1" ]] && PREFIX="homepage-broken"
    [[ "$NO_CHECK" == "1" ]] && PREFIX="homepage"
    if [[ "$OUTPUT_MODE" == "homepage" ]]; then
        OUTPUT_FILE="$PWD/${PREFIX}-${GH_USER}_${TIMESTAMP}.txt"
    else
        OUTPUT_FILE="$PWD/${PREFIX}-repos-${GH_USER}_${TIMESTAMP}.txt"
    fi
fi

vis_args=()
[[ "$VISIBILITY" != "all" ]] && vis_args=(--visibility "$VISIBILITY")

jq_filter='.[]'
[[ "$INCLUDE_FORKS" == "0" ]] && jq_filter='.[] | select(.isFork==false)'
jq_filter="$jq_filter | select(.homepageUrl != null and .homepageUrl != \"\") | [.nameWithOwner, .homepageUrl, (.visibility | ascii_downcase), (.isFork|tostring), (.isArchived|tostring)] | @tsv"

print_kv "User" "$GH_USER"
print_kv "Visibility" "$VISIBILITY"
print_kv "Forks" "$([[ $INCLUDE_FORKS == 1 ]] && echo included || echo excluded)"
print_kv "Mode" "$OUTPUT_MODE"
if [[ "$NO_CHECK" == "1" ]]; then
    print_kv "Check" "skipped (metadata only)"
else
    print_kv "Filter" "$([[ $BROKEN_ONLY == 1 ]] && echo "broken only" || echo "all rows")"
    print_kv "Concurrency" "$CONCURRENCY"
    print_kv "Timeout" "${TIMEOUT}s"
fi
[[ -n "$OUTPUT_FILE" ]] && print_kv "Output" "$OUTPUT_FILE"
echo

# 1. Fetch repos with non-empty homepage
entries=$(gh repo list "$GH_USER" "${vis_args[@]}" --limit 1000 \
    --json nameWithOwner,isFork,isArchived,visibility,homepageUrl --jq "$jq_filter")

if [[ -z "$entries" ]]; then
    echo "No repos with a homepage set."
    [[ -n "$OUTPUT_FILE" ]] && : > "$OUTPUT_FILE"
    exit 0
fi

total=$(echo "$entries" | wc -l | tr -d ' ')
if [[ "$NO_CHECK" == "0" ]]; then
    echo "Checking $total homepage URLs..."
    echo
fi

# 2. Check each homepage URL in parallel
# shellcheck disable=SC2329  # invoked indirectly via xargs bash -c
check_entry() {
    local slug="$1" url="$2" vis="$3" is_fork="$4" is_archived="$5"
    local code
    code=$(curl -s -o /dev/null -L -w "%{http_code}" \
        --max-time "$TIMEOUT" \
        -A "Mozilla/5.0 (github-find-repos-with-homepage)" \
        "$url" 2>/dev/null)
    code="${code:-000}"

    if [[ "$code" =~ ^(2|3)[0-9][0-9]$ ]]; then
        printf "OK\t%s\t%s\t%s\t%s\t%s\t%s\n" "$code" "$slug" "$url" "$vis" "$is_fork" "$is_archived"
    else
        printf "BROKEN\t%s\t%s\t%s\t%s\t%s\t%s\n" "$code" "$slug" "$url" "$vis" "$is_fork" "$is_archived"
    fi
}
export -f check_entry
export TIMEOUT

if [[ "$NO_CHECK" == "1" ]]; then
    # No HTTP round-trips - synthesize rows straight from the metadata.
    results=$(echo "$entries" | awk -F'\t' '{ print "-\t-\t" $0 }')
else
    results=$(echo "$entries" \
        | tr '\t' '\n' \
        | xargs -n 5 -P "$CONCURRENCY" bash -c 'check_entry "$@"' _)
fi

# 3. Print sorted (optionally only BROKEN rows)
display="$results"
[[ "$BROKEN_ONLY" == "1" ]] && display=$(echo "$results" | awk -F'\t' '$1=="BROKEN"')

echo "$display" | sort | while IFS=$'\t' read -r status code slug url vis is_fork is_archived; do
    [[ -z "$status" ]] && continue
    badges="$(format_badges "$vis" "$is_fork" "$is_archived")"
    if [[ "$status" == "-" ]]; then
        printf "${C_GREEN}✓${C_RESET} %-50s  %s%s\n" "$slug" "$url" "$badges"
    else
        printf "%s  %5s  %-50s  %s%s\n" "$(paint_status "$status")" "$code" "$slug" "$url" "$badges"
    fi
done

# 4. Build URL list from the displayed rows (slug = col 3, homepage = col 4)
if [[ "$OUTPUT_MODE" == "repo" ]]; then
    urls=$(echo "$display" | awk -F'\t' 'NF>=3 { print "https://github.com/" $3 }' | sort -u)
else
    urls=$(echo "$display" | awk -F'\t' 'NF>=4 { print $4 }' | sort -u)
fi

echo
if [[ "$NO_CHECK" == "1" ]]; then
    echo "${C_BOLD}Summary:${C_RESET} $total repos with a homepage set"
else
    ok=$(echo "$results" | grep -c '^OK' || true)
    fail=$(echo "$results" | grep -c '^BROKEN' || true)
    echo "${C_BOLD}Summary:${C_RESET} OK=$ok  BROKEN=$fail  TOTAL=$total"
fi

if [[ -n "$OUTPUT_FILE" ]]; then
    echo "$urls" > "$OUTPUT_FILE"
    echo "Written $(echo "$urls" | grep -c . || true) entries to: $OUTPUT_FILE"
fi

# Exit 1 when any homepage is BROKEN (linter-style, useful for chaining and CI).
[[ "$NO_CHECK" == "0" && "${fail:-0}" -gt 0 ]] && exit 1
exit 0
