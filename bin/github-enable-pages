#!/usr/bin/env bash
# Usage:
#   github-enable-pages -f links.txt                     # repos from a file
#   echo "https://github.com/o/r" | github-enable-pages  # repos from stdin
#   github-enable-pages owner/repo another/repo          # positional slugs
#   github-enable-pages -f links.txt -b gh-pages         # custom source branch (default: main)
#   github-enable-pages -f links.txt -b main -p /docs    # custom source path (default: /)
#   DRY_RUN=1 github-enable-pages -f links.txt           # show what would be done
#   github-enable-pages --dry-run -f links.txt          # same as DRY_RUN=1
#   github-enable-pages --help                           # show help
#
# Enables GitHub Pages for each repo on the list. Repos that already have
# Pages enabled are reported as HAVE and left untouched.
#
# Accepts, one entry per line (lines starting with # are ignored, duplicates
# collapsed, unrecognized lines reported as SKIP):
#   - https://github.com/owner/repo
#   - https://owner.github.io/repo/
#   - owner/repo
#
# Exit codes: 0 = no failures, 1 = at least one repo ended in a FAIL row.
#
# Requires: gh CLI (authenticated) with admin access on the repos.

set -u

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../shared/__shared.sh
source "$script_dir/../shared/__shared.sh"

normalize_dry_run
BRANCH="main"
PATH_IN_REPO="/"

if [[ $# -eq 0 && -t 0 ]]; then
    show_usage
    exit 0
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -f|--file)
            require_value --file "${2:-}" "a path"
            INPUT_FILE="$2"; shift 2 ;;
        -b|--branch)
            require_value --branch "${2:-}" "a branch name"
            BRANCH="$2"; shift 2 ;;
        -p|--path)
            require_value --path "${2:-}" "a path"
            PATH_IN_REPO="$2"; shift 2 ;;
        --dry-run)
            DRY_RUN=1; shift ;;
        -h|--help)
            show_usage; exit 0 ;;
        -*)
            echo "Unknown flag: $1 (use -f <file>, -b <branch>, -p <path>, --dry-run or --help)" >&2; exit 1 ;;
        *)
            POSITIONAL+=("$1"); shift ;;
    esac
done

require_cmd gh "brew install gh"

enable_pages() {
    local url="$1"
    local slug
    slug=$(url_to_slug "$url")

    if [[ -z "$slug" ]]; then
        print_row "SKIP" "$url" "unrecognized URL"
        return
    fi

    # HTTP 404 = Pages not enabled yet (proceed). Any other error (rate limit,
    # auth, network) is inconclusive: enabling blindly would POST over an
    # existing site and the dry-run preview would be wrong, so refuse instead.
    local probe
    if probe=$(gh api "repos/$slug/pages" 2>&1); then
        print_row "HAVE" "$slug" "Pages already enabled"
        return
    fi
    if ! grep -q 'HTTP 404' <<< "$probe"; then
        FAILED=$((FAILED + 1)); print_row "FAIL" "$slug" "Pages check inconclusive: $(head -n1 <<< "$probe")"
        return
    fi

    if [[ "$DRY_RUN" == "1" ]]; then
        print_row "DRY" "$slug" "would enable Pages ($BRANCH$PATH_IN_REPO)"
        return
    fi

    local out
    if out=$(gh api --method POST "repos/$slug/pages" \
        -f "source[branch]=$BRANCH" \
        -f "source[path]=$PATH_IN_REPO" 2>&1); then
        print_row "OK" "$slug" "Pages enabled ($BRANCH$PATH_IN_REPO)"
    else
        FAILED=$((FAILED + 1)); print_row "FAIL" "$slug" "$(echo "$out" | head -n 1)"
    fi
}

[[ "$DRY_RUN" == "1" ]] && echo "${C_YELLOW}== DRY RUN - nothing will be changed ==${C_RESET}"

validate_input_source

FAILED=0
while read -r url; do
    enable_pages "$url"
done < <(input_source \
    | normalize_input)

# Exit 1 when the repo listing failed or any repo ended in a FAIL row
# (useful for chaining and CI).
if input_source_failed; then
    echo "ERROR: could not list repositories - nothing was processed" >&2
    exit 1
fi
[[ "$FAILED" -gt 0 ]] && exit 1
exit 0
