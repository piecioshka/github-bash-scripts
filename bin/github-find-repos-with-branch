#!/usr/bin/env bash
# Usage:
#   github-find-repos-with-branch -u <username> -b <branch>         # branch name is required
#   github-find-repos-with-branch -u <username> -b master           # e.g. repos that still have 'master'
#   github-find-repos-with-branch -u <username> -b gh-pages         # e.g. leftover Pages branches
#   github-find-repos-with-branch -u <username> -v public           # only public
#   github-find-repos-with-branch -u <username> -v private          # only private
#   github-find-repos-with-branch -u <username> -F                  # include forks
#   github-find-repos-with-branch -u <username> -r                  # output repo URLs (github.com/owner/repo)
#   github-find-repos-with-branch -u <username> -o                  # also save URLs to auto-named file in $PWD
#   github-find-repos-with-branch -u <username> -o branches.txt     # also save URLs to a specific file
#   github-find-repos-with-branch --help                            # show help
#
# Lists repositories that have the given branch (-b is required).
# Default output: branch URLs (github.com/owner/repo/tree/<branch>).
# With -r / --repo-url: repository URLs.
# By default prints to stdout only. Pass -o to also save a file - bare -o
# generates <PWD>/branches-<branch>[-repos]-<username>_<timestamp>.txt,
# -o <path> uses that path.
#
# Env:
#   CONCURRENCY=10   how many repos to check in parallel
#
# Requires: gh CLI (authenticated)

set -u

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../shared/__shared.sh
source "$script_dir/../shared/__shared.sh"

BRANCH=""
OUTPUT_MODE="branch"    # branch | repo
CONCURRENCY="${CONCURRENCY:-10}"

if [[ $# -eq 0 && -t 0 ]]; then
    show_usage
    exit 0
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -u|--user)
            require_value --user "${2:-}" "a username"
            GH_USER="$2"; shift 2 ;;
        -b|--branch)
            require_value --branch "${2:-}" "a branch name"
            BRANCH="$2"; shift 2 ;;
        -v|--visibility)
            require_value --visibility "${2:-}" "a value"
            VISIBILITY="$2"; shift 2 ;;
        -F|--include-forks)
            INCLUDE_FORKS=1; shift ;;
        -r|--repo-url)
            OUTPUT_MODE="repo"; shift ;;
        -o|--output)
            if [[ -z "${2:-}" || "${2:-}" == -* ]]; then
                OUTPUT_FILE="__AUTO__"; shift 1
            else
                OUTPUT_FILE="$2"; shift 2
            fi ;;
        -h|--help)
            show_usage; exit 0 ;;
        *)
            echo "Unknown argument: $1 (use --help)" >&2; exit 1 ;;
    esac
done

if [[ -z "$GH_USER" ]]; then
    echo "ERROR: -u <username> is required" >&2
    show_usage
    exit 1
fi

if [[ -z "$BRANCH" ]]; then
    echo "ERROR: -b <branch> is required" >&2
    show_usage
    exit 1
fi

require_cmd gh "brew install gh"
validate_visibility "$VISIBILITY"

# Sanitize branch for filenames (slashes → dashes).
BRANCH_SAFE="${BRANCH//\//-}"

if [[ "$OUTPUT_FILE" == "__AUTO__" ]]; then
    TIMESTAMP="$(make_timestamp)"
    if [[ "$OUTPUT_MODE" == "repo" ]]; then
        OUTPUT_FILE="$PWD/branches-${BRANCH_SAFE}-repos-${GH_USER}_${TIMESTAMP}.txt"
    else
        OUTPUT_FILE="$PWD/branches-${BRANCH_SAFE}-${GH_USER}_${TIMESTAMP}.txt"
    fi
fi

vis_args=()
[[ "$VISIBILITY" != "all" ]] && vis_args=(--visibility "$VISIBILITY")

jq_filter='.[]'
[[ "$INCLUDE_FORKS" == "0" ]] && jq_filter='.[] | select(.isFork==false)'
jq_filter="$jq_filter | [.nameWithOwner, (.visibility | ascii_downcase), (.isFork|tostring), (.isArchived|tostring)] | @tsv"

print_kv "User" "$GH_USER"
print_kv "Branch" "$BRANCH"
print_kv "Visibility" "$VISIBILITY"
print_kv "Forks" "$([[ $INCLUDE_FORKS == 1 ]] && echo included || echo excluded)"
print_kv "Mode" "$OUTPUT_MODE"
print_kv "Concurrency" "$CONCURRENCY"
[[ -n "$OUTPUT_FILE" ]] && print_kv "Output" "$OUTPUT_FILE"
echo

# A failing `gh repo list` (unknown user, expired auth, rate limit) must not
# look like "this user has no repos" - report it and exit non-zero.
if ! repos=$(gh repo list "$GH_USER" "${vis_args[@]}" --limit 1000 \
    --json nameWithOwner,isFork,isArchived,visibility --jq "$jq_filter" 2>&1); then
    echo "ERROR: gh repo list failed for '$GH_USER': $(head -n1 <<< "$repos")" >&2
    exit 1
fi

if [[ -z "$repos" ]]; then
    echo "No repos match the filter."
    [[ -n "$OUTPUT_FILE" ]] && : > "$OUTPUT_FILE"
    exit 0
fi

total=$(echo "$repos" | wc -l | tr -d ' ')
echo "Checking $total repos for '$BRANCH' branch..."
echo

check_branch() {
    local slug="$1" vis="$2" is_fork="$3" is_archived="$4"
    local branch_name target_branch="$TARGET_BRANCH"
    # HTTP 404 = branch absent (a legitimate negative). Any other failure
    # (rate limit, network, auth) is inconclusive - surface it on stderr
    # instead of silently undercounting.
    if ! branch_name=$(gh api "repos/$slug/branches/$target_branch" --jq '.name' 2>&1); then
        grep -q 'HTTP 404' <<< "$branch_name" \
            || printf "WARN  %s - branch check inconclusive: %s\n" "$slug" "$(head -n1 <<< "$branch_name")" >&2
        return 0
    fi
    if [[ "$branch_name" == "$target_branch" ]]; then
        printf "%s\t%s\t%s\t%s\n" "$slug" "$vis" "$is_fork" "$is_archived"
    fi
}
export -f check_branch
export TARGET_BRANCH="$BRANCH"

# TSV fields passed as separate args (BSD xargs collapses tabs inside -I {}).
results=$(echo "$repos" | tr '\t' ' ' \
    | xargs -n 4 -P "$CONCURRENCY" bash -c 'check_branch "$@"' _)

# Pretty print
if [[ -n "$results" ]]; then
    while IFS=$'\t' read -r slug vis is_fork is_archived; do
        [[ -z "$slug" ]] && continue
        badges="$(format_badges "$vis" "$is_fork" "$is_archived")"
        printf "${C_GREEN}✓${C_RESET} %-50s ${C_DIM}→${C_RESET} https://github.com/%s/tree/%s%s\n" "$slug" "$slug" "$BRANCH" "$badges"
    done <<< "$(echo "$results" | sort)"
fi

if [[ "$OUTPUT_MODE" == "repo" ]]; then
    urls=$(echo "$results" | cut -f1 | grep -v '^$' | sort -u \
        | awk '{print "https://github.com/" $0}')
else
    urls=$(echo "$results" | cut -f1 | grep -v '^$' | sort -u \
        | awk -v b="$BRANCH" '{print "https://github.com/" $0 "/tree/" b}')
fi

found=$(echo "$urls" | grep -c . || true)
echo
echo "${C_BOLD}Found $found/$total repos with '$BRANCH' branch.${C_RESET}"

if [[ -n "$OUTPUT_FILE" ]]; then
    echo "$urls" > "$OUTPUT_FILE"
    echo "Written to: $OUTPUT_FILE"
fi
