#!/usr/bin/env bash
# Usage:
#   github-find-repos-with-projects-feature -u <username>                # all repos (forks excluded)
#   github-find-repos-with-projects-feature -u <username> -v public      # only public
#   github-find-repos-with-projects-feature -u <username> -v private     # only private
#   github-find-repos-with-projects-feature -u <username> -F             # include forks
#   github-find-repos-with-projects-feature -u <username> -e             # only repos with no linked projects (unused)
#   github-find-repos-with-projects-feature -u <username> -o             # also save URLs to auto-named file in $PWD
#   github-find-repos-with-projects-feature -u <username> -o out.txt     # also save URLs to a specific file
#   github-find-repos-with-projects-feature --help                       # show help
#
# Lists repositories whose Projects feature is ENABLED, with the number of
# Projects linked to each one. Pass -e / --only-unused to keep only the repos
# where the feature is on but no Project is linked (chain that output into
# github-disable-projects-feature -f <file>).
# Linked-project count is read from the GraphQL `projectsV2` field
# (Projects v2); legacy classic project boards are not counted.
# By default prints repo slugs to stdout. Pass -o to also save repo URLs —
# bare -o generates <PWD>/projects-<user>_<timestamp>.txt
# (projects-unused-<user>_… with --only-unused), -o <path> uses that path.
#
# Requires: gh CLI (authenticated, with read:project scope)

set -u

GH_USER=""
VISIBILITY="all"
INCLUDE_FORKS=0
ONLY_UNUSED=0
OUTPUT_FILE=""
CONCURRENCY="${CONCURRENCY:-10}"

show_usage() {
    sed -n '2,/^$/p' "$0" | sed -E 's/^# ?//'
}

if [[ $# -eq 0 && -t 0 ]]; then
    show_usage
    exit 0
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -u|--user)
            [[ -z "${2:-}" ]] && { echo "ERROR: --user requires a username" >&2; exit 1; }
            GH_USER="$2"; shift 2 ;;
        -v|--visibility)
            [[ -z "${2:-}" ]] && { echo "ERROR: --visibility requires a value" >&2; exit 1; }
            VISIBILITY="$2"; shift 2 ;;
        -F|--include-forks)
            INCLUDE_FORKS=1; shift ;;
        -e|--only-unused)
            ONLY_UNUSED=1; shift ;;
        -o|--output)
            if [[ -z "${2:-}" || "${2:-}" == -* ]]; then
                OUTPUT_FILE="__AUTO__"; shift 1
            else
                OUTPUT_FILE="$2"; shift 2
            fi ;;
        -h|--help)
            show_usage; exit 0 ;;
        *)
            echo "Unknown argument: $1 (use --help)" >&2; exit 1 ;;
    esac
done

if [[ -z "$GH_USER" ]]; then
    echo "ERROR: -u <user> is required" >&2
    show_usage
    exit 1
fi

if ! command -v gh > /dev/null 2>&1; then
    echo "ERROR: gh CLI not found. Install with: brew install gh" >&2
    exit 1
fi

case "$VISIBILITY" in
    public|private|all) ;;
    *) echo "ERROR: invalid visibility '$VISIBILITY' (use: public, private, all)" >&2; exit 1 ;;
esac

if [[ "$OUTPUT_FILE" == "__AUTO__" ]]; then
    TIMESTAMP="$(date +%Y-%m-%d_%H-%M-%S)"
    if [[ "$ONLY_UNUSED" == "1" ]]; then
        OUTPUT_FILE="$PWD/projects-unused-$GH_USER""_$TIMESTAMP.txt"
    else
        OUTPUT_FILE="$PWD/projects-$GH_USER""_$TIMESTAMP.txt"
    fi
fi

# colors (tty only)
if [[ -t 1 ]]; then
    C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'
    C_GREEN=$'\033[32m'; C_DIM=$'\033[90m'
    C_YELLOW=$'\033[33m'; C_BLUE=$'\033[94m'; C_BROWN=$'\033[38;5;94m'
else
    C_RESET=""; C_BOLD=""; C_GREEN=""; C_DIM=""
    C_YELLOW=""; C_BLUE=""; C_BROWN=""
fi

vis_args=()
[[ "$VISIBILITY" != "all" ]] && vis_args=(--visibility "$VISIBILITY")

jq_filter='.[] | select(.hasProjectsEnabled==true)'
[[ "$INCLUDE_FORKS" == "0" ]] && jq_filter="$jq_filter | select(.isFork==false)"
jq_filter="$jq_filter | [.nameWithOwner, (.visibility | ascii_downcase), (.isFork|tostring), (.isArchived|tostring)] | @tsv"

echo "${C_BOLD}User:${C_RESET}        $GH_USER"
echo "${C_BOLD}Visibility:${C_RESET}  $VISIBILITY"
echo "${C_BOLD}Forks:${C_RESET}       $([[ $INCLUDE_FORKS == 1 ]] && echo included || echo excluded)"
echo "${C_BOLD}Filter:${C_RESET}      $([[ $ONLY_UNUSED == 1 ]] && echo "unused only" || echo "all repos with Projects on")"
echo "${C_BOLD}Concurrency:${C_RESET} $CONCURRENCY"
[[ -n "$OUTPUT_FILE" ]] && echo "${C_BOLD}Output:${C_RESET}      $OUTPUT_FILE"
echo

repos=$(gh repo list "$GH_USER" "${vis_args[@]}" --limit 1000 \
    --json nameWithOwner,hasProjectsEnabled,visibility,isFork,isArchived --jq "$jq_filter")

if [[ -z "$repos" ]]; then
    echo "No repos with the Projects feature enabled."
    [[ -n "$OUTPUT_FILE" ]] && : > "$OUTPUT_FILE"
    exit 0
fi

total=$(echo "$repos" | wc -l | tr -d ' ')
echo "Checking $total repos with Projects enabled for linked projects..."
echo

# Emits "<slug>\t<count>\t<vis>\t<fork>\t<archived>" with the number of linked
# Projects v2. A failed count (network, auth, missing read:project scope) is
# inconclusive — warn on stderr and skip, rather than misreport it as unused.
count_projects() {
    local slug="$1" vis="$2" is_fork="$3" is_archived="$4"
    local owner="${slug%%/*}" name="${slug#*/}"
    local count
    # shellcheck disable=SC2016  # $owner/$name are GraphQL variables — must stay literal, gh binds them via -f
    count=$(gh api graphql \
        -f query='query($owner:String!,$name:String!){repository(owner:$owner,name:$name){projectsV2(first:1){totalCount}}}' \
        -f owner="$owner" -f name="$name" \
        --jq '.data.repository.projectsV2.totalCount' 2>/dev/null)
    if [[ ! "$count" =~ ^[0-9]+$ ]]; then
        printf "WARN  %s — projects check inconclusive (missing read:project scope?)\n" "$slug" >&2
        return 0
    fi
    printf "%s\t%s\t%s\t%s\t%s\n" "$slug" "$count" "$vis" "$is_fork" "$is_archived"
}
export -f count_projects

# Note: TSV fields are passed as separate positional args — BSD xargs collapses
# tabs inside -I {} substitution, so we split on whitespace via -n 4 instead.
results=$(echo "$repos" | tr '\t' ' ' \
    | xargs -n 4 -P "$CONCURRENCY" bash -c 'count_projects "$@"' _)

display="$results"
[[ "$ONLY_UNUSED" == "1" ]] && display=$(echo "$results" | awk -F'\t' '$2==0')

if [[ -n "$display" ]]; then
    while IFS=$'\t' read -r slug count vis is_fork is_archived; do
        [[ -z "$slug" ]] && continue
        if [[ "$count" == "0" ]]; then
            count_label="${C_YELLOW}0 projects${C_RESET}"
        elif [[ "$count" == "1" ]]; then
            count_label="${C_DIM}1 project${C_RESET}"
        else
            count_label="${C_DIM}$count projects${C_RESET}"
        fi
        badges=""
        [[ "$vis" == "private" ]] && badges="$badges ${C_YELLOW}[🔐 private]${C_RESET}"
        [[ "$is_fork" == "true" ]] && badges="$badges ${C_BLUE}[🍴 fork]${C_RESET}"
        [[ "$is_archived" == "true" ]] && badges="$badges ${C_BROWN}[📦 archived]${C_RESET}"
        printf "${C_GREEN}✓${C_RESET} %-50s %s%s\n" "$slug" "$count_label" "$badges"
    done <<< "$(echo "$display" | sort)"
fi

urls=$(echo "$display" | cut -f1 | grep -v '^$' | sort -u \
    | awk '{print "https://github.com/" $0}')

found=$(echo "$urls" | grep -c . || true)
unused_count=$(echo "$results" | awk -F'\t' '$2==0' | grep -c . || true)
echo
if [[ "$ONLY_UNUSED" == "1" ]]; then
    echo "${C_BOLD}${C_DIM}Found $found/$total repos with an unused Projects feature.${C_RESET}"
else
    echo "${C_BOLD}${C_DIM}Found $found/$total repos with the Projects feature enabled ($unused_count unused).${C_RESET}"
fi

if [[ -n "$OUTPUT_FILE" ]]; then
    echo "$urls" > "$OUTPUT_FILE"
    echo "Written to: $OUTPUT_FILE"
fi
