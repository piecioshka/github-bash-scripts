#!/usr/bin/env bash
# Usage:
#   github-find-repos-by-metadata -u <username> -q <query>                  # search all repos
#   github-find-repos-by-metadata -u <username> -q <query> -v public        # only public
#   github-find-repos-by-metadata -u <username> -q <query> -v private       # only private
#   github-find-repos-by-metadata -u <username> -q <query> -F               # include forks
#   github-find-repos-by-metadata -u <username> -q <query> -c               # case-sensitive
#   github-find-repos-by-metadata -u <username> -q <query> -E               # treat query as regex
#   github-find-repos-by-metadata -u <username> -q <query> -o               # also save repo URLs to auto-named file
#   github-find-repos-by-metadata -u <username> -q <query> -o out.txt       # also save repo URLs to a specific file
#   github-find-repos-by-metadata --help                                    # show help
#
# Searches across repo metadata (name, description, homepage, topics, language).
# Case-insensitive substring match by default. Use -E to interpret the query as
# an extended regex. Use -c for case-sensitive matching.
#
# By default prints matched rows to stdout only. Pass -o to also save unique
# repo URLs - bare -o generates <PWD>/search-<username>-<query>_<timestamp>.txt,
# -o <path> uses that path.
#
# Requires: gh CLI (authenticated), jq

set -u

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../shared/__shared.sh
source "$script_dir/../shared/__shared.sh"

QUERY=""
CASE_SENSITIVE=0
REGEX=0

if [[ $# -eq 0 && -t 0 ]]; then
    show_usage
    exit 0
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -u|--user)
            require_value --user "${2:-}" "a username"
            GH_USER="$2"; shift 2 ;;
        -q|--query)
            require_value --query "${2:-}" "a value"
            QUERY="$2"; shift 2 ;;
        -v|--visibility)
            require_value --visibility "${2:-}" "a value"
            VISIBILITY="$2"; shift 2 ;;
        -F|--include-forks)
            INCLUDE_FORKS=1; shift ;;
        -c|--case-sensitive)
            CASE_SENSITIVE=1; shift ;;
        -E|--regex)
            REGEX=1; shift ;;
        -o|--output)
            if [[ -z "${2:-}" || "${2:-}" == -* ]]; then
                OUTPUT_FILE="__AUTO__"; shift 1
            else
                OUTPUT_FILE="$2"; shift 2
            fi ;;
        -h|--help)
            show_usage; exit 0 ;;
        *)
            echo "Unknown argument: $1 (use --help)" >&2; exit 1 ;;
    esac
done

if [[ -z "$GH_USER" ]]; then
    echo "ERROR: -u <username> is required" >&2; exit 1
fi
if [[ -z "$QUERY" ]]; then
    echo "ERROR: -q <query> is required" >&2; exit 1
fi

require_cmd gh "brew install gh"
require_cmd jq "brew install jq"
validate_visibility "$VISIBILITY"

if [[ "$OUTPUT_FILE" == "__AUTO__" ]]; then
    TIMESTAMP="$(make_timestamp)"
    # sanitize query for filename (keep alphanumeric, dash, underscore)
    SAFE_Q=$(echo "$QUERY" | tr -c '[:alnum:]_-' '_' | sed 's/__*/_/g; s/^_//; s/_$//')
    [[ -z "$SAFE_Q" ]] && SAFE_Q="query"
    OUTPUT_FILE="$PWD/search-$GH_USER-${SAFE_Q}_${TIMESTAMP}.txt"
fi

vis_args=()
[[ "$VISIBILITY" != "all" ]] && vis_args=(--visibility "$VISIBILITY")

print_kv "User" "$GH_USER"
print_kv "Visibility" "$VISIBILITY"
print_kv "Forks" "$([[ $INCLUDE_FORKS == 1 ]] && echo included || echo excluded)"
print_kv "Query" "$QUERY"
print_kv "Match" "$([[ $CASE_SENSITIVE == 1 ]] && echo case-sensitive || echo case-insensitive) / $([[ $REGEX == 1 ]] && echo regex || echo substring)"
[[ -n "$OUTPUT_FILE" ]] && print_kv "Output" "$OUTPUT_FILE"
echo

# Fetch metadata for all repos in a single API call, then run two jq passes:
#   - triples: (slug \t field \t value) for substring/regex search
#   - meta:    (slug \t visibility \t isFork \t isArchived) lookup for badges
fork_filter='true'
[[ "$INCLUDE_FORKS" == "0" ]] && fork_filter='.isFork == false'

# A failing `gh repo list` (unknown user, expired auth, rate limit) must not
# look like "this user has no repos" - report it and exit non-zero.
if ! repos_json=$(gh repo list "$GH_USER" "${vis_args[@]}" --limit 1000 \
    --json nameWithOwner,description,homepageUrl,repositoryTopics,primaryLanguage,isFork,isArchived,visibility 2>&1); then
    echo "ERROR: gh repo list failed for '$GH_USER': $(head -n1 <<< "$repos_json")" >&2
    exit 1
fi

triples=$(echo "$repos_json" | jq -r "
    .[] | select($fork_filter) |
    . as \$r |
    [
        [\$r.nameWithOwner, \"name\",        \$r.nameWithOwner],
        [\$r.nameWithOwner, \"description\", (\$r.description // \"\")],
        [\$r.nameWithOwner, \"homepage\",    (\$r.homepageUrl // \"\")],
        [\$r.nameWithOwner, \"topics\",      ((\$r.repositoryTopics // []) | map(.name) | join(\",\"))],
        [\$r.nameWithOwner, \"language\",    (\$r.primaryLanguage.name // \"\")]
    ][] | select(.[2] != \"\") | @tsv
")

meta_tsv=$(echo "$repos_json" | jq -r "
    .[] | select($fork_filter) |
    [.nameWithOwner, (.visibility | ascii_downcase), (.isFork|tostring), (.isArchived|tostring)] | @tsv
")

total_repos=$(echo "$triples" | cut -f1 | sort -u | wc -l | tr -d ' ')

# Build grep flags
grep_flags=(-E)
[[ "$CASE_SENSITIVE" == "0" ]] && grep_flags+=(-i)
[[ "$REGEX" == "0" ]] && grep_flags=(-F)
[[ "$REGEX" == "0" && "$CASE_SENSITIVE" == "0" ]] && grep_flags=(-Fi)

# Filter to rows whose VALUE column matches the query. grep must see the value
# column alone - matching against the whole line would also hit the slug and
# the field-name columns (e.g. -q description would match every repo that has
# any description). The matching line numbers then select rows from the TSV.
matched_nums=$(echo "$triples" | cut -f3 \
    | grep -n "${grep_flags[@]}" -- "$QUERY" | cut -d: -f1)
matches=""
if [[ -n "$matched_nums" ]]; then
    matches=$(echo "$triples" | awk -F'\t' \
        'NR==FNR { want[$1] = 1; next } FNR in want' \
        <(printf '%s\n' "$matched_nums") /dev/stdin)
fi

if [[ -z "$matches" ]]; then
    echo "No matches across $total_repos repos."
    [[ -n "$OUTPUT_FILE" ]] && : > "$OUTPUT_FILE"
    exit 0
fi

# Pretty print - group by slug
lookup_badges() {
    local slug="$1" line vis is_fork is_archived
    line=$(echo "$meta_tsv" | awk -F'\t' -v s="$slug" '$1==s {print; exit}')
    [[ -z "$line" ]] && return
    IFS=$'\t' read -r _ vis is_fork is_archived <<< "$line"
    format_badges "$vis" "$is_fork" "$is_archived"
}

current_slug=""
echo "$matches" | sort | while IFS=$'\t' read -r slug field value; do
    if [[ "$slug" != "$current_slug" ]]; then
        [[ -n "$current_slug" ]] && echo
        printf "${C_BOLD}${C_CYAN}%s${C_RESET}%s\n" "$slug" "$(lookup_badges "$slug")"
        current_slug="$slug"
    fi
    printf "  ${C_GREEN}%-12s${C_RESET} ${C_DIM}|${C_RESET} %s\n" "$field" "$value"
done
echo

# Build unique list of matched repo URLs
urls=$(echo "$matches" | cut -f1 | sort -u \
    | awk '{print "https://github.com/" $0}')

matched_repos=$(echo "$urls" | grep -c . || true)
echo "${C_BOLD}Found $matched_repos/$total_repos repos matching '$QUERY'.${C_RESET}"

if [[ -n "$OUTPUT_FILE" ]]; then
    echo "$urls" > "$OUTPUT_FILE"
    echo "Written to: $OUTPUT_FILE"
fi
