#!/usr/bin/env bash
# Usage:
#   github-clear-homepage -u <username>                    # all non-fork repos of a user
#   github-clear-homepage -u <username> -v public          # only public
#   github-clear-homepage -u <username> -v private         # only private
#   github-clear-homepage -u <username> -F                 # include forks
#   github-clear-homepage -f links.txt                     # repos from a file
#   echo "https://github.com/o/r" | github-clear-homepage  # repos from stdin
#   github-clear-homepage owner/repo another/repo          # positional slugs
#   github-clear-homepage -u <username> --force            # clear ANY homepage (not only *.github.io)
#   DRY_RUN=1 github-clear-homepage -u <username>          # show what would be done
#   github-clear-homepage --dry-run -u <username>          # same as DRY_RUN=1
#   github-clear-homepage --help                           # show help
#
# For each repo on the list: if the repo's website/homepage URL points to a
# *.github.io address, clears it. Repos whose homepage is something else
# (or empty) are skipped - unless --force is used, which clears ANY non-empty
# homepage.
#
# Accepts, one entry per line (lines starting with # are ignored, duplicates
# collapsed, unrecognized lines reported as SKIP):
#   - https://github.com/owner/repo
#   - https://owner.github.io/repo/
#   - owner/repo
#
# Exit codes: 0 = no failures, 1 = at least one repo ended in a FAIL row.
#
# Requires: gh CLI (authenticated) with admin access on the repos.

set -u

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../shared/__shared.sh
source "$script_dir/../shared/__shared.sh"

normalize_dry_run

if [[ $# -eq 0 && -t 0 ]]; then
    show_usage
    exit 0
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -u|--user)
            require_value --user "${2:-}" "a username"
            GH_USER="$2"; shift 2 ;;
        -v|--visibility)
            require_value --visibility "${2:-}" "a value"
            VISIBILITY="$2"; shift 2 ;;
        -F|--include-forks)
            INCLUDE_FORKS=1; shift ;;
        -f|--file)
            require_value --file "${2:-}" "a path"
            INPUT_FILE="$2"; shift 2 ;;
        --force)
            FORCE=1; shift ;;
        --dry-run)
            DRY_RUN=1; shift ;;
        -h|--help)
            show_usage; exit 0 ;;
        -*)
            echo "Unknown flag: $1 (use -f <file>, -u <username>, --force, --dry-run or --help)" >&2; exit 1 ;;
        *)
            POSITIONAL+=("$1"); shift ;;
    esac
done

require_cmd gh "brew install gh"
validate_visibility "$VISIBILITY"

clear_homepage() {
    local url="$1"
    local slug
    slug=$(url_to_slug "$url")

    if [[ -z "$slug" ]]; then
        print_row "SKIP" "$url" "unrecognized URL"
        return
    fi

    local homepage
    if ! homepage=$(gh api "repos/$slug" --jq '.homepage // ""' 2>/dev/null); then
        FAILED=$((FAILED + 1)); print_row "FAIL" "$slug" "cannot read repo (404 or no access)"
        return
    fi

    if [[ -z "$homepage" ]]; then
        print_row "KEEP" "$slug" "homepage already empty"
        return
    fi

    # Only clear if homepage points to *.github.io, unless --force
    if [[ "$FORCE" != "1" && ! "$homepage" =~ ^https?://[^/]+\.github\.io(/|$) ]]; then
        print_row "KEEP" "$slug" "homepage not *.github.io: $homepage (use --force to override)"
        return
    fi

    if [[ "$DRY_RUN" == "1" ]]; then
        local note="would clear homepage ($homepage)"
        [[ "$FORCE" == "1" ]] && note="$note [forced]"
        print_row "DRY" "$slug" "$note"
        return
    fi

    local out
    if out=$(gh repo edit "$slug" --homepage "" 2>&1); then
        print_row "OK" "$slug" "cleared (was: $homepage)"
    else
        FAILED=$((FAILED + 1)); print_row "FAIL" "$slug" "$(echo "$out" | head -n 1)"
    fi
}

[[ "$DRY_RUN" == "1" ]] && echo "${C_YELLOW}== DRY RUN - nothing will be changed ==${C_RESET}"
[[ "$FORCE" == "1" ]] && echo "${C_RED}== FORCE mode - will clear ANY homepage ==${C_RESET}"

validate_input_source

FAILED=0
while read -r url; do
    clear_homepage "$url"
done < <(input_source \
    | normalize_input)

# Exit 1 when the repo listing failed or any repo ended in a FAIL row
# (useful for chaining and CI).
if input_source_failed; then
    echo "ERROR: could not list repositories - nothing was processed" >&2
    exit 1
fi
[[ "$FAILED" -gt 0 ]] && exit 1
exit 0
