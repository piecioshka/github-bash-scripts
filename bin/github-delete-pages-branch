#!/usr/bin/env bash
# Usage:
#   github-delete-pages-branch -f links.txt                    # repos from a file
#   echo "https://github.com/o/r" | github-delete-pages-branch # repos from stdin
#   github-delete-pages-branch owner/repo another/repo         # positional slugs
#   DRY_RUN=1 github-delete-pages-branch -f links.txt          # show what would be done
#   github-delete-pages-branch --help                          # show help
#
# Disables GitHub Pages for each repo on the list by DELETING the 'gh-pages'
# branch. This is NOT a symmetric undo of github-enable-pages (which only
# changes configuration): the branch and its history are permanently removed.
#
# Actions per repo (in order):
#   1. Delete the 'gh-pages' branch - stops the site serving.
#   2. Try DELETE /repos/.../pages - often returns 422 for legacy setups; non-fatal.
#
# Safety guards: only the 'gh-pages' branch is ever deleted. Repos whose Pages
# source is another branch, is unknown, or whose Pages are built by GitHub
# Actions (build_type=workflow) are refused.
#
# Accepts both URL formats (one per line, lines starting with # are ignored):
#   - https://github.com/owner/repo
#   - https://owner.github.io/repo/
#
# WARNING: branch deletion is DESTRUCTIVE and IRREVERSIBLE (unless you have a
# local copy of the branch). Preview with DRY_RUN=1 first.
# Requires: gh CLI (authenticated) with admin access on the repos.

set -u

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../shared/__shared.sh
source "$script_dir/../shared/__shared.sh"

DRY_RUN="${DRY_RUN:-0}"

if [[ $# -eq 0 && -t 0 ]]; then
    show_usage
    exit 0
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -f|--file)
            [[ -z "${2:-}" ]] && { echo "ERROR: --file requires a path" >&2; exit 1; }
            INPUT_FILE="$2"; shift 2 ;;
        -h|--help)
            show_usage; exit 0 ;;
        -*)
            echo "Unknown flag: $1 (use -f <file> or --help)" >&2; exit 1 ;;
        *)
            POSITIONAL+=("$1"); shift ;;
    esac
done

require_cmd gh "brew install gh"

delete_pages_branch() {
    local url="$1"
    local slug
    slug=$(url_to_slug "$url")

    if [[ -z "$slug" ]]; then
        print_row "SKIP" "$url" "unrecognized URL"
        return
    fi

    # Check if Pages enabled and fetch source branch
    local branch
    if ! branch=$(gh api "repos/$slug/pages" --jq '.source.branch // "gh-pages"' 2>/dev/null); then
        print_row "NONE" "$slug" "Pages not enabled"
        return
    fi

    # SAFETY: only 'gh-pages' is allowed to be deleted. Never touch main/master/etc.
    if [[ "$branch" != "gh-pages" ]]; then
        print_row "SKIP" "$slug" "Pages source is '$branch' (not 'gh-pages') - refusing to delete"
        return
    fi

    if [[ "$DRY_RUN" == "1" ]]; then
        print_row "DRY" "$slug" "would delete branch 'gh-pages' + try Pages API DELETE"
        return
    fi

    local notes

    # 1. Delete 'gh-pages' branch - effectively disables the site
    if gh api -X DELETE "repos/$slug/git/refs/heads/gh-pages" > /dev/null 2>&1; then
        notes="branch 'gh-pages' deleted"
    else
        notes="branch 'gh-pages' delete failed"
    fi

    # 2. Try Pages API DELETE - best effort, may return 422 for legacy sites
    if gh api --method DELETE "repos/$slug/pages" > /dev/null 2>&1; then
        notes="$notes + Pages API disabled"
    else
        notes="$notes + Pages API refused (expected)"
    fi

    if [[ "$notes" == "branch '"*"' deleted"* ]]; then
        print_row "OK" "$slug" "$notes"
    else
        print_row "FAIL" "$slug" "$notes"
    fi
}

if [[ "$DRY_RUN" == "1" ]]; then
    echo "${C_YELLOW}== DRY RUN - nothing will be changed ==${C_RESET}"
else
    echo "${C_RED}== WARNING: this PERMANENTLY deletes the 'gh-pages' branch in the listed repos ==${C_RESET}"
    echo "${C_RED}==          preview first with: DRY_RUN=1 github-delete-pages-branch ... ==${C_RESET}"
fi

input_source \
    | grep -vE '^[[:space:]]*(#|$)' \
    | grep -Eo 'https?://[^ ]+' \
    | while read -r url; do
        delete_pages_branch "$url"
    done
