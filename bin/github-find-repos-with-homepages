#!/usr/bin/env bash
# Usage:
#   github-find-repos-with-homepages -u <username>              # all repos (forks excluded)
#   github-find-repos-with-homepages -u <username> -v public    # only public
#   github-find-repos-with-homepages -u <username> -v private   # only private
#   github-find-repos-with-homepages -u <username> -F           # include forks
#   github-find-repos-with-homepages -u <username> -e           # only broken homepages (non-2xx/3xx)
#   github-find-repos-with-homepages -u <username> -n           # just list, skip the HTTP check
#   github-find-repos-with-homepages -u <username> -r           # output repo URLs (github.com/owner/repo)
#   github-find-repos-with-homepages -u <username> -o           # also save URLs to auto-named file in $PWD
#   github-find-repos-with-homepages -u <username> -o out.txt   # also save URLs to a specific file
#   github-find-repos-with-homepages --help                     # show help
#
# Lists repositories with a homepage set and checks each URL over HTTP:
# OK for 2xx/3xx, BROKEN otherwise. Pass -e / --only-broken to keep only the
# BROKEN rows (with -r that output chains into github-clear-homepages).
# Pass -n / --no-check for an instant list straight from repo metadata,
# without touching the homepages over HTTP (-e makes no sense then).
# Default mode: homepage URLs. With -r / --repo-url: repository URLs.
# By default prints to stdout only. Pass -o to also save a file — bare -o
# generates <PWD>/homepages-checked[-repos]-<user>_<timestamp>.txt
# (homepages-broken[-repos]-<user>_… with --only-broken and
# homepages[-repos]-<user>_… with --no-check), -o <path> uses that path.
#
# Env:
#   CONCURRENCY=10   parallelism for URL checks
#   TIMEOUT=15       per-request timeout in seconds
#
# Requires: gh CLI (authenticated), curl

set -u

GH_USER=""
VISIBILITY="all"
INCLUDE_FORKS=0
BROKEN_ONLY=0
NO_CHECK=0
OUTPUT_FILE=""
OUTPUT_MODE="homepage"    # homepage | repo
CONCURRENCY="${CONCURRENCY:-10}"
TIMEOUT="${TIMEOUT:-15}"

show_usage() {
    sed -n '2,/^$/p' "$0" | sed -E 's/^# ?//'
}

if [[ $# -eq 0 && -t 0 ]]; then
    show_usage
    exit 0
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -u|--user)
            [[ -z "${2:-}" ]] && { echo "ERROR: --user requires a username" >&2; exit 1; }
            GH_USER="$2"; shift 2 ;;
        -v|--visibility)
            [[ -z "${2:-}" ]] && { echo "ERROR: --visibility requires a value" >&2; exit 1; }
            VISIBILITY="$2"; shift 2 ;;
        -F|--include-forks)
            INCLUDE_FORKS=1; shift ;;
        -r|--repo-url)
            OUTPUT_MODE="repo"; shift ;;
        -e|--only-broken)
            BROKEN_ONLY=1; shift ;;
        -n|--no-check)
            NO_CHECK=1; shift ;;
        -o|--output)
            if [[ -z "${2:-}" || "${2:-}" == -* ]]; then
                OUTPUT_FILE="__AUTO__"; shift 1
            else
                OUTPUT_FILE="$2"; shift 2
            fi ;;
        -h|--help)
            show_usage; exit 0 ;;
        *)
            echo "Unknown argument: $1 (use --help)" >&2; exit 1 ;;
    esac
done

if [[ -z "$GH_USER" ]]; then
    echo "ERROR: -u <user> is required" >&2
    show_usage
    exit 1
fi

if ! command -v gh > /dev/null 2>&1; then
    echo "ERROR: gh CLI not found. Install with: brew install gh" >&2
    exit 1
fi

case "$VISIBILITY" in
    public|private|all) ;;
    *) echo "ERROR: invalid visibility '$VISIBILITY' (use: public, private, all)" >&2; exit 1 ;;
esac

if [[ "$NO_CHECK" == "1" && "$BROKEN_ONLY" == "1" ]]; then
    echo "ERROR: -n/--no-check cannot be combined with -e/--only-broken" >&2
    exit 1
fi

if [[ "$OUTPUT_FILE" == "__AUTO__" ]]; then
    TIMESTAMP="$(date +%Y-%m-%d_%H-%M-%S)"
    PREFIX="homepages-checked"
    [[ "$BROKEN_ONLY" == "1" ]] && PREFIX="homepages-broken"
    [[ "$NO_CHECK" == "1" ]] && PREFIX="homepages"
    if [[ "$OUTPUT_MODE" == "homepage" ]]; then
        OUTPUT_FILE="$PWD/$PREFIX-$GH_USER""_$TIMESTAMP.txt"
    else
        OUTPUT_FILE="$PWD/$PREFIX-repos-$GH_USER""_$TIMESTAMP.txt"
    fi
fi

# colors (tty only)
if [[ -t 1 ]]; then
    C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'
    C_GREEN=$'\033[32m'; C_RED=$'\033[31m'; C_DIM=$'\033[90m'
    C_YELLOW=$'\033[33m'; C_BLUE=$'\033[94m'; C_BROWN=$'\033[38;5;94m'
else
    C_RESET=""; C_BOLD=""; C_GREEN=""; C_RED=""; C_DIM=""
    C_YELLOW=""; C_BLUE=""; C_BROWN=""
fi

paint_status() {
    local status="$1"
    local padded
    printf -v padded "%-6s" "$status"
    case "$status" in
        OK)     printf "%s%s%s" "$C_GREEN" "$padded" "$C_RESET" ;;
        BROKEN) printf "%s%s%s" "$C_RED"   "$padded" "$C_RESET" ;;
        *)      printf "%s%s%s" "$C_DIM"   "$padded" "$C_RESET" ;;
    esac
}

vis_args=()
[[ "$VISIBILITY" != "all" ]] && vis_args=(--visibility "$VISIBILITY")

jq_filter='.[]'
[[ "$INCLUDE_FORKS" == "0" ]] && jq_filter='.[] | select(.isFork==false)'
jq_filter="$jq_filter | select(.homepageUrl != null and .homepageUrl != \"\") | [.nameWithOwner, .homepageUrl, (.visibility | ascii_downcase), (.isFork|tostring), (.isArchived|tostring)] | @tsv"

echo "${C_BOLD}User:${C_RESET}        $GH_USER"
echo "${C_BOLD}Visibility:${C_RESET}  $VISIBILITY"
echo "${C_BOLD}Forks:${C_RESET}       $([[ $INCLUDE_FORKS == 1 ]] && echo included || echo excluded)"
echo "${C_BOLD}Mode:${C_RESET}        $OUTPUT_MODE"
if [[ "$NO_CHECK" == "1" ]]; then
    echo "${C_BOLD}Check:${C_RESET}       skipped (metadata only)"
else
    echo "${C_BOLD}Filter:${C_RESET}      $([[ $BROKEN_ONLY == 1 ]] && echo "broken only" || echo "all rows")"
    echo "${C_BOLD}Concurrency:${C_RESET} $CONCURRENCY"
    echo "${C_BOLD}Timeout:${C_RESET}     ${TIMEOUT}s"
fi
[[ -n "$OUTPUT_FILE" ]] && echo "${C_BOLD}Output:${C_RESET}      $OUTPUT_FILE"
echo

# 1. Fetch repos with non-empty homepage
entries=$(gh repo list "$GH_USER" "${vis_args[@]}" --limit 1000 \
    --json nameWithOwner,isFork,isArchived,visibility,homepageUrl --jq "$jq_filter")

if [[ -z "$entries" ]]; then
    echo "No repos with a homepage set."
    [[ -n "$OUTPUT_FILE" ]] && : > "$OUTPUT_FILE"
    exit 0
fi

total=$(echo "$entries" | wc -l | tr -d ' ')
if [[ "$NO_CHECK" == "0" ]]; then
    echo "Checking $total homepage URLs..."
    echo
fi

# 2. Check each homepage URL in parallel
check_entry() {
    local slug="$1" url="$2" vis="$3" is_fork="$4" is_archived="$5"
    local code
    code=$(curl -s -o /dev/null -L -w "%{http_code}" \
        --max-time "$TIMEOUT" \
        -A "Mozilla/5.0 (github-find-repos-with-homepages)" \
        "$url" 2>/dev/null)
    code="${code:-000}"

    if [[ "$code" =~ ^(2|3)[0-9][0-9]$ ]]; then
        printf "OK\t%s\t%s\t%s\t%s\t%s\t%s\n" "$code" "$slug" "$url" "$vis" "$is_fork" "$is_archived"
    else
        printf "BROKEN\t%s\t%s\t%s\t%s\t%s\t%s\n" "$code" "$slug" "$url" "$vis" "$is_fork" "$is_archived"
    fi
}
export -f check_entry
export TIMEOUT

if [[ "$NO_CHECK" == "1" ]]; then
    # No HTTP round-trips — synthesize rows straight from the metadata.
    results=$(echo "$entries" | awk -F'\t' '{ print "-\t-\t" $0 }')
else
    results=$(echo "$entries" \
        | tr '\t' '\n' \
        | xargs -n 5 -P "$CONCURRENCY" bash -c 'check_entry "$@"' _)
fi

# 3. Print sorted (optionally only BROKEN rows)
display="$results"
[[ "$BROKEN_ONLY" == "1" ]] && display=$(echo "$results" | awk -F'\t' '$1=="BROKEN"')

echo "$display" | sort | while IFS=$'\t' read -r status code slug url vis is_fork is_archived; do
    [[ -z "$status" ]] && continue
    badges=""
    [[ "$vis" == "private" ]] && badges="$badges ${C_YELLOW}[🔐 private]${C_RESET}"
    [[ "$is_fork" == "true" ]] && badges="$badges ${C_BLUE}[🍴 fork]${C_RESET}"
    [[ "$is_archived" == "true" ]] && badges="$badges ${C_BROWN}[📦 archived]${C_RESET}"
    if [[ "$status" == "-" ]]; then
        printf "${C_GREEN}✓${C_RESET} %-50s  %s%s\n" "$slug" "$url" "$badges"
    else
        printf "%s  %5s  %-50s  %s%s\n" "$(paint_status "$status")" "$code" "$slug" "$url" "$badges"
    fi
done

# 4. Build URL list from the displayed rows (slug = col 3, homepage = col 4)
if [[ "$OUTPUT_MODE" == "repo" ]]; then
    urls=$(echo "$display" | awk -F'\t' 'NF>=3 { print "https://github.com/" $3 }' | sort -u)
else
    urls=$(echo "$display" | awk -F'\t' 'NF>=4 { print $4 }' | sort -u)
fi

echo
if [[ "$NO_CHECK" == "1" ]]; then
    echo "${C_BOLD}Summary:${C_RESET} $total repos with a homepage set"
else
    ok=$(echo "$results" | grep -c '^OK' || true)
    fail=$(echo "$results" | grep -c '^BROKEN' || true)
    echo "${C_BOLD}Summary:${C_RESET} OK=$ok  BROKEN=$fail  TOTAL=$total"
fi

if [[ -n "$OUTPUT_FILE" ]]; then
    echo "$urls" > "$OUTPUT_FILE"
    echo "Written $(echo "$urls" | grep -c . || true) entries to: $OUTPUT_FILE"
fi
