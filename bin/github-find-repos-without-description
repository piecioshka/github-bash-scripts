#!/usr/bin/env bash
# Usage:
#   github-find-repos-without-description -u <username>                # all repos (forks excluded)
#   github-find-repos-without-description -u <username> -v public      # only public
#   github-find-repos-without-description -u <username> -v private     # only private
#   github-find-repos-without-description -u <username> -F             # include forks
#   github-find-repos-without-description -u <username> -o             # also save URLs to auto-named file in $PWD
#   github-find-repos-without-description -u <username> -o out.txt     # also save URLs to a specific file
#   github-find-repos-without-description --help                       # show help
#
# Lists repositories that have no description set (empty or null). Fetched in a
# single API call - no per-repo roundtrips.
# By default prints repo slugs to stdout. Pass -o to also save repo URLs -
# bare -o generates <PWD>/description-empty-<username>_<timestamp>.txt, -o <path>
# uses that path.
#
# Requires: gh CLI (authenticated)

set -u

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../shared/__shared.sh
source "$script_dir/../shared/__shared.sh"

if [[ $# -eq 0 && -t 0 ]]; then
    show_usage
    exit 0
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -u|--user)
            require_value --user "${2:-}" "a username"
            GH_USER="$2"; shift 2 ;;
        -v|--visibility)
            require_value --visibility "${2:-}" "a value"
            VISIBILITY="$2"; shift 2 ;;
        -F|--include-forks)
            INCLUDE_FORKS=1; shift ;;
        -o|--output)
            if [[ -z "${2:-}" || "${2:-}" == -* ]]; then
                OUTPUT_FILE="__AUTO__"; shift 1
            else
                OUTPUT_FILE="$2"; shift 2
            fi ;;
        -h|--help)
            show_usage; exit 0 ;;
        *)
            echo "Unknown argument: $1 (use --help)" >&2; exit 1 ;;
    esac
done

if [[ -z "$GH_USER" ]]; then
    echo "ERROR: -u <username> is required" >&2
    show_usage
    exit 1
fi

require_cmd gh "brew install gh"
validate_visibility "$VISIBILITY"

if [[ "$OUTPUT_FILE" == "__AUTO__" ]]; then
    TIMESTAMP="$(make_timestamp)"
    OUTPUT_FILE="$PWD/description-empty-${GH_USER}_${TIMESTAMP}.txt"
fi

vis_args=()
[[ "$VISIBILITY" != "all" ]] && vis_args=(--visibility "$VISIBILITY")

# Emit every (fork-filtered) repo as TSV prefixed with an empty/set flag, so a
# single list call yields both the total count and the empty-description subset.
jq_filter='.[]'
[[ "$INCLUDE_FORKS" == "0" ]] && jq_filter='.[] | select(.isFork==false)'
jq_filter="$jq_filter | [(if (.description // \"\") == \"\" then \"empty\" else \"set\" end), .nameWithOwner, (.visibility | ascii_downcase), (.isFork|tostring), (.isArchived|tostring)] | @tsv"

print_kv "User" "$GH_USER"
print_kv "Visibility" "$VISIBILITY"
print_kv "Forks" "$([[ $INCLUDE_FORKS == 1 ]] && echo included || echo excluded)"
[[ -n "$OUTPUT_FILE" ]] && print_kv "Output" "$OUTPUT_FILE"
echo

rows=$(gh repo list "$GH_USER" "${vis_args[@]}" --limit 1000 \
    --json nameWithOwner,description,visibility,isFork,isArchived --jq "$jq_filter")

total=$(echo "$rows" | grep -c . || true)
results=$(echo "$rows" | awk -F'\t' 'BEGIN{OFS="\t"} $1=="empty"{print $2,$3,$4,$5}')

if [[ -z "$results" ]]; then
    echo "No repos with an empty description."
    [[ -n "$OUTPUT_FILE" ]] && : > "$OUTPUT_FILE"
    exit 0
fi

while IFS=$'\t' read -r slug vis is_fork is_archived; do
    [[ -z "$slug" ]] && continue
    badges="$(format_badges "$vis" "$is_fork" "$is_archived")"
    printf "${C_GREEN}✓${C_RESET} %s%s\n" "$slug" "$badges"
done <<< "$(echo "$results" | sort)"

urls=$(echo "$results" | cut -f1 | grep -v '^$' | sort -u \
    | awk '{print "https://github.com/" $0}')

found=$(echo "$urls" | grep -c . || true)
echo
echo "${C_BOLD}${C_DIM}Found $found/$total repos with an empty description.${C_RESET}"

if [[ -n "$OUTPUT_FILE" ]]; then
    echo "$urls" > "$OUTPUT_FILE"
    echo "Written to: $OUTPUT_FILE"
fi
