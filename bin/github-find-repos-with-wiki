#!/usr/bin/env bash
# Usage:
#   github-find-repos-with-wiki -u <username>                   # all repos (forks excluded)
#   github-find-repos-with-wiki -u <username> -v public         # only public
#   github-find-repos-with-wiki -u <username> -v private        # only private
#   github-find-repos-with-wiki -u <username> -F                # include forks
#   github-find-repos-with-wiki -u <username> -e                # only wikis with no pages (empty)
#   github-find-repos-with-wiki -u <username> -o                # also save URLs to auto-named file in $PWD
#   github-find-repos-with-wiki -u <username> -o out.txt        # also save URLs to a specific file
#   github-find-repos-with-wiki --help                          # show help
#
# Lists repositories whose wiki feature is ENABLED, with the number of wiki
# pages each one has. Pass -e / --only-unused to keep only the wikis without a
# single page (chain that output into github-disable-wiki -f <file>).
# A wiki lives in a separate git repo at <repo>.wiki.git; an empty wiki has no
# such repo, so `git ls-remote` returns no refs. Page counts come from a
# blobless, no-checkout clone of the wiki repo (trees only, no file contents).
# By default prints repo slugs to stdout. Pass -o to also save repo URLs —
# bare -o generates <PWD>/wiki-<username>_<timestamp>.txt (wiki-unused-<username>_… with
# --only-unused), -o <path> uses that path.
#
# Requires: gh CLI (authenticated), git

set -u

GH_USER=""
VISIBILITY="all"
INCLUDE_FORKS=0
ONLY_UNUSED=0
OUTPUT_FILE=""
CONCURRENCY="${CONCURRENCY:-10}"

show_usage() {
    sed -n '2,/^$/p' "$0" | sed -E 's/^# ?//'
}

if [[ $# -eq 0 && -t 0 ]]; then
    show_usage
    exit 0
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -u|--user)
            [[ -z "${2:-}" ]] && { echo "ERROR: --user requires a username" >&2; exit 1; }
            GH_USER="$2"; shift 2 ;;
        -v|--visibility)
            [[ -z "${2:-}" ]] && { echo "ERROR: --visibility requires a value" >&2; exit 1; }
            VISIBILITY="$2"; shift 2 ;;
        -F|--include-forks)
            INCLUDE_FORKS=1; shift ;;
        -e|--only-unused)
            ONLY_UNUSED=1; shift ;;
        -o|--output)
            if [[ -z "${2:-}" || "${2:-}" == -* ]]; then
                OUTPUT_FILE="__AUTO__"; shift 1
            else
                OUTPUT_FILE="$2"; shift 2
            fi ;;
        -h|--help)
            show_usage; exit 0 ;;
        *)
            echo "Unknown argument: $1 (use --help)" >&2; exit 1 ;;
    esac
done

if [[ -z "$GH_USER" ]]; then
    echo "ERROR: -u <username> is required" >&2
    show_usage
    exit 1
fi

if ! command -v gh > /dev/null 2>&1; then
    echo "ERROR: gh CLI not found. Install with: brew install gh" >&2
    exit 1
fi
if ! command -v git > /dev/null 2>&1; then
    echo "ERROR: git not found." >&2
    exit 1
fi

case "$VISIBILITY" in
    public|private|all) ;;
    *) echo "ERROR: invalid visibility '$VISIBILITY' (use: public, private, all)" >&2; exit 1 ;;
esac

# Token is needed so the wiki check works for private repos too. It is passed to
# git via a credential helper reading an env var — never on the command line.
if ! GH_WIKI_TOKEN="$(gh auth token 2>/dev/null)" || [[ -z "$GH_WIKI_TOKEN" ]]; then
    echo "ERROR: cannot read gh auth token. Run: gh auth login" >&2
    exit 1
fi
export GH_WIKI_TOKEN

if [[ "$OUTPUT_FILE" == "__AUTO__" ]]; then
    TIMESTAMP="$(date +%Y-%m-%d_%H-%M-%S)"
    if [[ "$ONLY_UNUSED" == "1" ]]; then
        OUTPUT_FILE="$PWD/wiki-unused-$GH_USER""_$TIMESTAMP.txt"
    else
        OUTPUT_FILE="$PWD/wiki-$GH_USER""_$TIMESTAMP.txt"
    fi
fi

# colors (tty only)
if [[ -t 1 ]]; then
    C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'
    C_GREEN=$'\033[32m'; C_DIM=$'\033[90m'
    C_YELLOW=$'\033[33m'; C_BLUE=$'\033[94m'; C_BROWN=$'\033[38;5;94m'
else
    C_RESET=""; C_BOLD=""; C_GREEN=""; C_DIM=""
    C_YELLOW=""; C_BLUE=""; C_BROWN=""
fi

vis_args=()
[[ "$VISIBILITY" != "all" ]] && vis_args=(--visibility "$VISIBILITY")

jq_filter='.[] | select(.hasWikiEnabled==true)'
[[ "$INCLUDE_FORKS" == "0" ]] && jq_filter="$jq_filter | select(.isFork==false)"
jq_filter="$jq_filter | [.nameWithOwner, (.visibility | ascii_downcase), (.isFork|tostring), (.isArchived|tostring)] | @tsv"

echo "${C_BOLD}User:${C_RESET}        $GH_USER"
echo "${C_BOLD}Visibility:${C_RESET}  $VISIBILITY"
echo "${C_BOLD}Forks:${C_RESET}       $([[ $INCLUDE_FORKS == 1 ]] && echo included || echo excluded)"
echo "${C_BOLD}Filter:${C_RESET}      $([[ $ONLY_UNUSED == 1 ]] && echo "empty wikis only" || echo "all wikis")"
echo "${C_BOLD}Concurrency:${C_RESET} $CONCURRENCY"
[[ -n "$OUTPUT_FILE" ]] && echo "${C_BOLD}Output:${C_RESET}      $OUTPUT_FILE"
echo

repos=$(gh repo list "$GH_USER" "${vis_args[@]}" --limit 1000 \
    --json nameWithOwner,hasWikiEnabled,visibility,isFork,isArchived --jq "$jq_filter")

if [[ -z "$repos" ]]; then
    echo "No repos with the wiki feature enabled."
    [[ -n "$OUTPUT_FILE" ]] && : > "$OUTPUT_FILE"
    exit 0
fi

total=$(echo "$repos" | wc -l | tr -d ' ')
echo "Checking $total candidate repos (wiki flag on)..."
echo

# Emits "<slug>\t<pages>\t<vis>\t<fork>\t<archived>" for every repo whose wiki
# feature is really on. A wiki lives in a separate <repo>.wiki.git; an empty
# wiki has no such repo, so GitHub reports "Repository not found" (0 pages).
# A reachable wiki gets a blobless, no-checkout clone and its pages are counted
# as files with a wiki markup extension. Any other failure (network, auth, rate
# limit) is inconclusive — warn on stderr and skip, rather than misreport.
# Auth via the GH_WIKI_TOKEN helper.
inspect_wiki() {
    local slug="$1" vis="$2" is_fork="$3" is_archived="$4"
    local out rc has_wiki pages tmp
    # The GraphQL hasWikiEnabled flag used for the pre-filter can disagree with
    # the repo settings (it reports the stored flag even when the wiki feature
    # is not actually available, e.g. private repos on a free plan). Trust the
    # REST has_wiki field as the source of truth and skip repos without a wiki.
    if ! has_wiki=$(gh api "repos/$slug" --jq '.has_wiki' 2>/dev/null); then
        printf "WARN  %s — wiki check inconclusive: cannot read repo via REST\n" "$slug" >&2
        return 0
    fi
    [[ "$has_wiki" == "true" ]] || { printf "SKIP\t%s\n" "$slug"; return 0; }
    # shellcheck disable=SC2016  # $1/$GH_WIKI_TOKEN must stay literal — git expands them when it runs the helper
    out=$(git -c credential.helper='' \
        -c credential.helper='!f() { test "$1" = get && printf "username=x-access-token\npassword=%s\n" "$GH_WIKI_TOKEN"; }; f' \
        ls-remote "https://github.com/$slug.wiki.git" 2>&1)
    rc=$?
    if [[ $rc -ne 0 ]]; then
        if grep -qi 'not found' <<< "$out"; then
            pages=0
        else
            printf "WARN  %s — wiki check inconclusive: %s\n" "$slug" "$(head -n1 <<< "$out")" >&2
            return 0
        fi
    elif [[ -z "$out" ]]; then
        pages=0
    else
        tmp=$(mktemp -d) || { printf "WARN  %s — cannot create temp dir\n" "$slug" >&2; return 0; }
        # shellcheck disable=SC2016  # same literal-expansion rule as above
        if git -c credential.helper='' \
            -c credential.helper='!f() { test "$1" = get && printf "username=x-access-token\npassword=%s\n" "$GH_WIKI_TOKEN"; }; f' \
            clone --quiet --depth 1 --filter=blob:none --no-checkout \
            "https://github.com/$slug.wiki.git" "$tmp/wiki" 2>/dev/null; then
            pages=$(git -C "$tmp/wiki" ls-tree -r --name-only HEAD 2>/dev/null \
                | grep -ciE '\.(md|markdown|mdown|mkdn|textile|rdoc|org|creole|rst|asciidoc|adoc|wiki|mediawiki|pod)$' || true)
        else
            rm -rf "$tmp"
            printf "WARN  %s — wiki check inconclusive: clone failed\n" "$slug" >&2
            return 0
        fi
        rm -rf "$tmp"
    fi
    printf "%s\t%s\t%s\t%s\t%s\n" "$slug" "$pages" "$vis" "$is_fork" "$is_archived"
}
export -f inspect_wiki

# Note: TSV fields are passed as separate positional args — BSD xargs collapses
# tabs inside -I {} substitution, so we split on whitespace via -n 4 instead.
raw_results=$(echo "$repos" | tr '\t' ' ' \
    | xargs -n 4 -P "$CONCURRENCY" bash -c 'inspect_wiki "$@"' _)

# Candidates whose wiki flag is on but the feature is not actually available
# (REST has_wiki=false) come back as SKIP rows — count and drop them.
skipped=$(echo "$raw_results" | awk -F'\t' '$1=="SKIP"' | grep -c . || true)
results=$(echo "$raw_results" | awk -F'\t' '$1!="SKIP"')

display="$results"
[[ "$ONLY_UNUSED" == "1" ]] && display=$(echo "$results" | awk -F'\t' '$2==0')

if [[ -n "$display" ]]; then
    while IFS=$'\t' read -r slug pages vis is_fork is_archived; do
        [[ -z "$slug" ]] && continue
        if [[ "$pages" == "0" ]]; then
            pages_label="${C_YELLOW}0 pages${C_RESET}"
        elif [[ "$pages" == "1" ]]; then
            pages_label="${C_DIM}1 page${C_RESET}"
        else
            pages_label="${C_DIM}$pages pages${C_RESET}"
        fi
        badges=""
        [[ "$vis" == "private" ]] && badges="$badges ${C_YELLOW}[🔐 private]${C_RESET}"
        [[ "$is_fork" == "true" ]] && badges="$badges ${C_BLUE}[🍴 fork]${C_RESET}"
        [[ "$is_archived" == "true" ]] && badges="$badges ${C_BROWN}[📦 archived]${C_RESET}"
        printf "${C_GREEN}✓${C_RESET} %-50s %s%s\n" "$slug" "$pages_label" "$badges"
    done <<< "$(echo "$display" | sort)"
fi

urls=$(echo "$display" | cut -f1 | grep -v '^$' | sort -u \
    | awk '{print "https://github.com/" $0}')

found=$(echo "$urls" | grep -c . || true)
empty_count=$(echo "$results" | awk -F'\t' '$2==0' | grep -c . || true)
echo
if [[ "$ONLY_UNUSED" == "1" ]]; then
    echo "${C_BOLD}${C_DIM}Found $found/$total repos with an empty wiki.${C_RESET}"
else
    echo "${C_BOLD}${C_DIM}Found $found/$total repos with the wiki feature enabled ($empty_count empty).${C_RESET}"
fi
if [[ "$skipped" -gt 0 ]]; then
    echo "${C_DIM}Skipped $skipped candidate(s): wiki flag on, but the feature is not actually available (not shown in repo settings).${C_RESET}"
fi

if [[ -n "$OUTPUT_FILE" ]]; then
    echo "$urls" > "$OUTPUT_FILE"
    echo "Written to: $OUTPUT_FILE"
fi
